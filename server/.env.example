# Database
DATABASE_URL=postgresql://user:your_password@localhost:5432/your_database

# JWT
SECRET_KEY=YOUR_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (for rate limiting)
# Running locally (no Docker):  redis://localhost:6379/0
# Running inside Docker Compose: redis://redis:6379/0   (service name, not localhost)
REDIS_URL=redis://localhost:6379/0

# App
ENVIRONMENT=development
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5432, http://localhost:8000
PORT=8000

#
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
